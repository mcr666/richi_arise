{
	"multipart": [
		{
			"when": { "game_active": "false", "on_slab": "false" },
			"apply": { "model": "riichi_arise:block/fengpan_small" }
		},
		{
			"when": { "game_active": "false", "on_slab": "true" },
			"apply": { "model": "riichi_arise:block/fengpan_small_slab" }
		},
		{ "when": { "game_active": "true" }, "apply": { "model": "riichi_arise:block/empty" } }
	]
}
